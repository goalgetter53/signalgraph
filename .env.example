# Copy to .env (never commit .env). All values are optional.
SIGNALGRAPH_DB=signalgraph.duckdb
# Sent in the User-Agent; SEC EDGAR requires a real contact address.
SIGNALGRAPH_CONTACT_EMAIL=you@example.com
SIGNALGRAPH_CONFIG_DIR=./config
SIGNALGRAPH_HTTP_TIMEOUT=20
SIGNALGRAPH_MAX_RETRIES=4
# Optional: raises GitHub's unauthenticated limit (60 req/h) to 5000 req/h.
GITHUB_TOKEN=
